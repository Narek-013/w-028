{
  "name": "sam-inna",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "directus:up": "docker compose -f ../helper_default/docker-compose.yaml up -d postgres directus",
    "directus:down": "docker compose -f ../helper_default/docker-compose.yaml down",
    "directus:logs": "docker compose -f ../helper_default/docker-compose.yaml logs -f directus",
    "directus:migrate": "cd ../helper_default/.migrations && pnpm setup:schema && pnpm migrate",
    "directus:setup": "npm run directus:up && npm run directus:migrate"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "sass": "^1.88.0",
    "sass-embedded": "^1.88.0",
    "vite": "^6.3.5"
  }
}
